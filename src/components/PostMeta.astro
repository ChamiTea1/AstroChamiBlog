---
import { siteConfig, themeConfig } from '../config';
import { __, formatDate } from '../i18n';
import type { Post } from '../utils/collections';

interface Props {
	post: Post;
	wordCount?: number;
	minutes?: number;
}

const { post, wordCount, minutes } = Astro.props;
const { data } = post;

const articleDateFormat = 'YYYY-MM-DD HH:mm:ss';
const formatArticleDate = (value: Date) => formatDate(value, articleDateFormat).replace(' 00:00:00', '').replace(':00', '');

const categories = Array.isArray(data.categories) ? data.categories : data.categories ? [data.categories] : [];
const tags = Array.isArray(data.tags) ? data.tags : data.tags ? [data.tags] : [];

const categoryUrl = (cat: string) => `/categories/${cat.split('/').map(encodeURIComponent).join('/')}/`;
const tagUrl = (tag: string) => `/tags/${encodeURIComponent(tag.toLowerCase())}/`;

const isOriginal = !data.author || data.author === siteConfig.author;
const showWordCount = themeConfig.articles.word_count.enable && themeConfig.articles.word_count.count && wordCount !== undefined;
const showMinutes = themeConfig.articles.word_count.enable && themeConfig.articles.word_count.min2read && minutes !== undefined;
const showPv = themeConfig.global.website_counter.enable && themeConfig.global.website_counter.post_pv;
---

<div class="flex flex-col gap-1.5 text-sm text-rd-gray-900 [&_a:hover]:text-primary">
	<div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
		<span class="select-none rounded-md bg-primary px-2 py-0.5 text-xs font-semibold text-rd-primary-text">
			{isOriginal ? __('original') : __('reprint')}
		</span>
		<span class="flex items-center gap-1.5">
			<i class="fa-regular fa-calendar text-xs" aria-hidden="true"></i>
			<span class="text-xs text-rd-gray-800">{__('create_time')}</span>
			<time datetime={data.pubDate.toISOString()}>{formatArticleDate(data.pubDate)}</time>
		</span>
		{
			data.updatedDate && data.updatedDate.valueOf() !== data.pubDate.valueOf() && (
				<span class="flex items-center gap-1.5">
					<i class="fa-regular fa-history text-xs" aria-hidden="true"></i>
					<span class="text-xs text-rd-gray-800">{__('update_time')}</span>
					<time datetime={data.updatedDate.toISOString()}>{formatArticleDate(data.updatedDate)}</time>
				</span>
			)
		}
	</div>

	<div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
		{
			categories.length > 0 && (
				<span class="flex items-center gap-1.5">
					<i class="fa-regular fa-folder text-xs" aria-hidden="true"></i>
					{categories.map((cat, i) => (
						<span class="inline-flex items-center">
							{i > 0 && <span class="mx-1 text-rd-gray-800">/</span>}
							<a href={categoryUrl(cat)}>{cat}</a>
						</span>
					))}
				</span>
			)
		}
		{
			tags.length > 0 && (
				<span class="hidden items-center gap-1.5 sm:flex">
					<i class="fa-regular fa-tags text-xs" aria-hidden="true"></i>
					{tags.map((tag, i) => (
						<span class="inline-flex items-center">
							{i > 0 && <span class="mx-1 text-rd-gray-800">|</span>}
							<a href={tagUrl(tag)}>#{tag}</a>
						</span>
					))}
				</span>
			)
		}
		{
			showWordCount && (
				<span class="flex items-center gap-1.5">
					<i class="fa-regular fa-file-word text-xs" aria-hidden="true"></i>
					{__('post_wordcount')}: {wordCount}
				</span>
			)
		}
		{
			showMinutes && (
				<span class="flex items-center gap-1.5">
					<i class="fa-regular fa-clock text-xs" aria-hidden="true"></i>
					{__('post_min2read')}: {minutes} {__('min2read')}
				</span>
			)
		}
		{
			showPv && (
				<span class="flex items-center gap-1.5">
					<i class="fa-regular fa-eye text-xs" aria-hidden="true"></i>
					{__('post_page_pv')}: <span id="busuanzi_value_page_pv"></span>
				</span>
			)
		}
	</div>
</div>
