---
import { getCollection } from 'astro:content';
import { themeConfig } from '../config';
import { normalizePostCover, sortPosts, stripMarkdown, type Post } from '../utils/collections';

interface Props {
	post: Post;
}

const { post } = Astro.props;

const cfg = themeConfig.articles.recommendation;

const skip = cfg.skip_dirs.some((dir) => new RegExp(`^${dir}`, 'g').test(post.id));
let recommendations: { id: string; title: string; image: string }[] = [];

if (!skip) {
	const allPosts = sortPosts(await getCollection('blog'));

	const cleanData = (data: string): string => {
		let text = data.replace(/\s/g, ' ');
		text = text.replace(/!\[(.*?)\]\(.*?\)/g, '$1');
		text = text.replace(/(http|ftp|https):\/\/[\w\-_]+(\.[\w\-_]+)+([\w\-.,@?^=%&amp;:/~+#]*[\w\-@?^=%&amp;/~+#])?/g, ' ');
		text = text.replace(/[^\p{L}\p{N}\s]/gu, ' ');
		text = text.replace(/\d+/g, ' ');
		text = text.replace(/\s+/g, ' ');
		return text.trim();
	};

	const tokenize = (data: string): string[] => {
		const cleaned = cleanData(stripMarkdown(data));
		const tokens: string[] = [];
		const latinMatches = cleaned.match(/[a-zA-Z][a-zA-Z0-9'-]*/g) ?? [];
		latinMatches.forEach((word) => tokens.push(word.toLowerCase()));
		const cjk = cleaned.replace(/[a-zA-Z0-9\s'-]/g, '');
		for (let i = 0; i < cjk.length - 1; i++) {
			tokens.push(cjk.slice(i, i + 2));
		}
		return tokens.filter((token) => token.trim());
	};

	const library = allPosts.map((p) => ({
		id: p.id,
		title: p.data.title,
		image: (() => {
			const cover = normalizePostCover(p.data);
			if (typeof cover === 'string') return cover;
			if (cover && typeof cover === 'object' && 'src' in cover) return cover.src;
			return cfg.placeholder;
		})(),
		tokens: tokenize(p.body ?? ''),
	}));

	const corpus = library.map((item) => item.tokens);
	const cosineSimilarity = (vector1: number[], vector2: number[]): number => {
		let numerator = 0;
		let sqrt1 = 0;
		let sqrt2 = 0;
		if (vector1.length === vector2.length) {
			for (let i = 0; i < vector1.length; i++) {
				numerator += vector1[i] * vector2[i];
				sqrt1 += vector1[i] * vector1[i];
				sqrt2 += vector2[i] * vector2[i];
			}
		}
		return numerator / (Math.sqrt(sqrt1) * Math.sqrt(sqrt2) || 1);
	};

	const allWords = [...new Set(corpus.flat())];
	const wordLibrary: Record<string, number> = {};
	allWords.forEach((word) => {
		wordLibrary[word] = 0;
	});

	const documentCountLibrary = { ...wordLibrary };
	const wordFrequencies: Record<string, number>[] = [];
	corpus.forEach((wordsInArticle) => {
		const wordOccurrence = { ...wordLibrary };
		wordsInArticle.forEach((word) => {
			if (word in wordOccurrence) wordOccurrence[word]++;
		});
		const frequency = { ...wordLibrary };
		for (const word of Object.keys(wordLibrary)) {
			frequency[word] = wordOccurrence[word] / (wordsInArticle.length || 1);
		}
		wordFrequencies.push(frequency);
		for (const word of Object.keys(wordLibrary)) {
			if (frequency[word]) documentCountLibrary[word]++;
		}
	});

	const vectors = wordFrequencies.map((frequency) =>
		Object.keys(wordLibrary).map((word) => {
			const idf = Math.log(corpus.length / (documentCountLibrary[word] + 1));
			return frequency[word] * idf;
		}),
	);

	const currentIndex = library.findIndex((item) => item.id === post.id);
	if (currentIndex !== -1) {
		const similarities = library.map((item, index) => ({
			...item,
			score: index === currentIndex ? -1 : cosineSimilarity(vectors[currentIndex], vectors[index]),
		}));
		similarities.sort((a, b) => b.score - a.score);
		recommendations = similarities.filter((item) => item.score > 0).slice(0, cfg.limit);
	}
}

const mobileLimit = cfg.mobile_limit;
const coverUrl = (item: { id: string; title: string; image: string }) => ({
	url: `/blog/${item.id}/`,
	title: item.title,
	image: item.image,
});
---

{
	recommendations.length > 0 && (
		<section class="overflow-visible px-2 sm:px-6 md:px-8">
			<div class="mt-10 text-xl font-bold md:text-3xl">
				<span>{cfg.title}</span>
			</div>
			<div class="flex flex-wrap justify-between overflow-visible py-2.5">
				{recommendations.map((item, index) => {
					const { url, title, image } = coverUrl(item);
					const hideOnTablet = index >= mobileLimit;
					return (
						<a
							class:list={[
								'mt-[15px] flex max-h-[200px] w-[32%] flex-wrap content-center items-center justify-center overflow-hidden rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 !p-3 max-[768px]:w-[49%]',
								hideOnTablet && 'max-[768px]:hidden',
							]}
							href={url}
							title={title}
							rel="bookmark"
						>
							<img src={image} alt={title} class="!-mx-3 !-mt-3 !mb-0 flex h-[150px] !w-[calc(100%+24px)] !max-w-none object-cover" />
							<span class="mt-2 block overflow-hidden [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:1]">
								{title}
							</span>
						</a>
					);
				})}
			</div>
		</section>
	)
}
