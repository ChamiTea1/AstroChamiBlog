---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { __ } from '../i18n';
import musicData from '../data/music.json';

interface PlaylistEntry {
	name: string;
	server: string;
	type: string;
	id: string;
}

const title = __('music');
const playlists = (musicData as unknown as PlaylistEntry[]).filter((p) => p.id && p.name);
const serverName = (server: string) => (server === 'tencent' ? 'QQ音乐' : '网易云音乐');
const playUrl = (p: PlaylistEntry) =>
	`/music/play/?server=${encodeURIComponent(p.server)}&type=${encodeURIComponent(p.type || 'playlist')}&id=${encodeURIComponent(p.id)}&name=${encodeURIComponent(p.name)}`;
---

<BaseLayout title={title}>
	<div id="main-content" class="relative box-border h-full w-9/10 max-w-content transition-[max-width,width] duration-200 ease-in-out sm:w-6/7 md:w-4/5">
		<div class="py-8 sm:py-0">
			<PageTitle title={title} showBorder />

			<ul id="music-list" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
				{
					playlists.map((p) => (
						<li>
							<a href={playUrl(p)} class="group flex flex-col">
								<div class="music-cover flex aspect-square w-full items-center justify-center overflow-hidden rounded-2xl border border-rd-gray-alpha-400 text-rd-gray-900">
									<i class="fa-solid fa-music text-3xl" aria-hidden="true"></i>
								</div>
								<div class="flex flex-col px-1 pt-2">
									<span class="truncate text-sm font-medium text-rd-gray-1000 group-hover:!text-primary">{p.name}</span>
									<span class="text-xs text-rd-gray-900">{serverName(p.server)}</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>

			<h2 class="mt-8 mb-3 text-lg font-bold text-rd-gray-1000">{__('music_my')}</h2>
			<form id="music-add-form" class="flex flex-col gap-3 rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-4 sm:flex-row sm:flex-wrap sm:items-end">
				<label class="flex flex-col gap-1 text-xs text-rd-gray-900">
					{__('music_platform')}
					<select id="music-add-server" class="rounded-lg border border-rd-gray-alpha-400 bg-rd-gray-100 px-3 py-2 text-sm text-rd-gray-1000 outline-none">
						<option value="netease">网易云音乐</option>
						<option value="tencent">QQ音乐</option>
					</select>
				</label>
				<label class="flex min-w-0 flex-1 flex-col gap-1 text-xs text-rd-gray-900">
					{__('music_link')}
					<input id="music-add-id" type="text" placeholder="https://music.163.com/playlist?id=…" class="rounded-lg border border-rd-gray-alpha-400 bg-rd-gray-100 px-3 py-2 text-sm text-rd-gray-1000 outline-none placeholder:text-rd-gray-900" />
				</label>
				<label class="flex flex-col gap-1 text-xs text-rd-gray-900 sm:w-40">
					{__('music_name_label')}
					<input id="music-add-name" type="text" class="rounded-lg border border-rd-gray-alpha-400 bg-rd-gray-100 px-3 py-2 text-sm text-rd-gray-1000 outline-none" />
				</label>
				<button type="submit" class="rounded-lg bg-primary px-5 py-2 text-sm font-semibold text-rd-primary-text transition-opacity hover:opacity-85">
					{__('music_add_btn')}
				</button>
				<p id="music-add-hint" class="hidden text-xs text-red-500 sm:basis-full" aria-live="polite"></p>
			</form>
			<p class="mt-3 text-xs text-rd-gray-900">{__('music_local_only')}</p>
		</div>
	</div>
</BaseLayout>

<style>
	.music-cover {
		background: linear-gradient(135deg, var(--rd-gray-200), var(--rd-gray-100));
	}
</style>
