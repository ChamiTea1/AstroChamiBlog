---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { __ } from '../i18n';
import albumsData from '../data/masonry.json';

interface MasonryItem {
	image?: string;
	title?: string;
	description?: string;
	width?: number;
	height?: number;
	exif?: boolean;
}

interface MasonryAlbum {
	name: string;
	slug: string;
	cover?: string;
	description?: string;
	items?: MasonryItem[];
}

const albums = (albumsData as unknown as MasonryAlbum[]).filter((album) => album.slug && album.name);

const title = __('photos');
---

<BaseLayout title={title}>
	<div id="main-content" class="relative box-border h-full w-9/10 max-w-content transition-[max-width,width] duration-200 ease-in-out sm:w-6/7 md:w-4/5">
		<div class="py-8 sm:py-0">
			<PageTitle title={title} showBorder />
			{
				albums.length > 0 ? (
					<ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{albums.map((album) => (
							<li>
								<a
									href={`/photos/${album.slug}/`}
									class="group flex flex-col overflow-hidden rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 shadow-rd transition-colors duration-300 hover:border-primary/40"
								>
									<div class="aspect-[4/3] w-full overflow-hidden bg-rd-gray-100">
										<img
											src={album.cover}
											alt={album.name}
											class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<div class="flex flex-col gap-1.5 p-4">
										<div class="flex items-baseline justify-between gap-2">
											<span class="truncate text-lg font-bold text-rd-gray-1000 transition-colors group-hover:!text-primary">{album.name}</span>
											<span class="shrink-0 text-xs text-rd-gray-900">{__('photos_count', String(album.items?.length ?? 0))}</span>
										</div>
										{album.description && <p class="line-clamp-2 text-sm text-rd-gray-900">{album.description}</p>}
									</div>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="py-10 text-center text-sm text-rd-gray-900">{__('photos_empty')}</p>
				)
			}
		</div>
	</div>
</BaseLayout>
