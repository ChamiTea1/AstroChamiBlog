---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { __ } from '../../i18n';
import musicData from '../../data/music.json';

const title = __('music');

interface PlaylistEntry {
	name: string;
	server: string;
	type: string;
	id: string;
	cover?: string;
}

const playlists = (musicData as unknown as PlaylistEntry[]).filter((p) => p.id && p.name);
const playlistsJson = JSON.stringify(
	playlists.map((p) => ({ name: p.name, server: p.server, type: p.type || 'playlist', id: p.id, cover: p.cover || '' })),
);
---

<BaseLayout title={title} music>
	<div class="music-page relative w-full">
		<div id="music-player" class="relative z-10"></div>

		<button id="music-switch" type="button" class="music-tool" title={__('music_switch')} aria-label={__('music_switch')}>
			<i class="fa-solid fa-repeat" aria-hidden="true"></i>
		</button>
		<button id="music-random" type="button" class="music-tool" title={__('music_random')} aria-label={__('music_random')}>
			<i class="fa-solid fa-shuffle" aria-hidden="true"></i>
		</button>
		<button id="music-refresh" type="button" class="music-tool" title={__('music_refresh')} aria-label={__('music_refresh')}>
			<i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
		</button>
		<a href="/music/" class="music-tool" title={__('music_back')} aria-label={__('music_back')}>
			<i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
		</a>
	</div>
	<div id="music-bg" aria-hidden="true"></div>
</BaseLayout>

<script is:inline set:html={`window.music_playlists = ${playlistsJson};`}></script>

<style is:global>
	/* ============================================================ */
	/* 沉浸式音乐播放页（参考 LuviciiBlog：html[data-type="music"]）   */
	/* ============================================================ */

	html[data-type='music'],
	html[data-type='music'] body {
		background: rgb(13, 13, 13) !important;
	}

	/* 文字颜色整体转白（导航栏等依赖这些变量） */
	html[data-type='music'] {
		--rd-gray-1000: #fff;
		--rd-gray-900: rgb(255 255 255 / 72%);
		--rd-gray-800: rgb(255 255 255 / 60%);
		--rd-gray-alpha-400: rgb(255 255 255 / 20%);
	}

	/* 导航栏透明化 */
	html[data-type='music'] #navbar {
		background: transparent !important;
		backdrop-filter: none !important;
		-webkit-backdrop-filter: none !important;
		box-shadow: none !important;
		border: none !important;
	}

	/* 主内容铺满、去背景去内边距 */
	html[data-type='music'] #swup,
	html[data-type='music'] #page-shell,
	html[data-type='music'] #page-content,
	html[data-type='music'] #page-content > div {
		background: transparent !important;
	}

	html[data-type='music'] #page-content {
		padding: 0 !important;
	}

	/* 隐藏页脚与侧边工具 */
	html[data-type='music'] #site-footer,
	html[data-type='music'] #side-tools {
		display: none !important;
	}

	/* 全页模糊封面背景（随歌曲切换） */
	#music-bg {
		display: block;
		position: fixed;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		z-index: -999;
		background-position: center center;
		background-size: cover;
		background-repeat: no-repeat;
		filter: blur(63px);
		opacity: 0.5;
		transition: background-image 0.3s ease;
	}

	/* 右下角悬浮圆形按钮 */
	.music-tool {
		position: fixed;
		right: 7vw;
		z-index: 45;
		display: flex;
		width: 50px;
		height: 50px;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: 50%;
		background: rgb(255 255 255 / 12%);
		backdrop-filter: saturate(180%) blur(20px);
		-webkit-backdrop-filter: blur(20px);
		color: #fff;
		font-size: 0.95rem;
		cursor: pointer;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			transform 0.2s ease;
	}

	.music-tool:hover {
		background: rgb(255 255 255 / 24%);
		color: #fff;
		transform: scale(1.05);
	}

	#music-switch {
		bottom: 100px;
	}

	#music-random {
		bottom: 160px;
	}

	#music-refresh {
		bottom: 220px;
	}

	.music-page > a.music-tool {
		bottom: 280px;
	}

	/* ============================================================ */
	/* 播放器：左封面+歌词（40%），右歌单列表（60%），满屏高度        */
	/* ============================================================ */

	#music-player .aplayer-inline {
		margin: 0;
	}

	#music-player .aplayer {
		margin: 0;
		display: flex;
		flex-direction: row-reverse;
		height: calc(100vh - var(--current-navbar-height));
		background: transparent !important;
		border: none !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		color: #fff;
	}

	#music-player .aplayer-body {
		width: 40%;
		height: calc(100vh - var(--current-navbar-height) - 40px);
		padding: 2.5rem 1.5rem 10rem;
	}

	#music-player .aplayer-pic {
		position: relative;
		top: auto;
		right: auto;
		bottom: auto;
		left: auto;
		float: none;
		width: 180px;
		height: 180px;
		margin: 0 auto;
		border-radius: 14px;
		background-color: transparent !important;
		background-size: cover;
		box-shadow: 0 12px 32px rgb(0 0 0 / 40%);
	}

	#music-player .aplayer-info {
		margin: 1.25rem 1.25rem 0;
		border-bottom: none;
	}

	#music-player .aplayer-music {
		height: auto;
		margin: 0.75rem 0;
		text-align: center;
	}

	#music-player .aplayer-music .aplayer-title {
		max-width: 100%;
		font-size: 1.5rem;
		font-weight: 700;
		color: #fff;
	}

	#music-player .aplayer-music .aplayer-author {
		font-size: 1rem;
		color: rgb(255 255 255 / 65%);
	}

	#music-player .aplayer-lrc {
		height: auto;
		margin-top: 1rem;
		text-align: center;
		mask-image: linear-gradient(to bottom, #000 70%, transparent);
	}

	#music-player .aplayer-lrc p {
		font-size: 1rem;
		line-height: 2.4rem;
		color: rgb(255 255 255 / 60%);
	}

	#music-player .aplayer-lrc p.aplayer-lrc-current {
		color: #fff;
	}

	/* 控制条固定在视口底部（参考 LuviciiBlog） */
	#music-player .aplayer-controller {
		position: fixed;
		right: 0;
		bottom: 50px;
		left: 0;
		max-width: 1500px;
		margin: 0 auto;
	}

	#music-player .aplayer-controller .aplayer-bar-wrap {
		margin: 0 calc(7vw + 70px) 0 150px;
	}

	#music-player .aplayer-controller .aplayer-bar {
		height: 6px;
		border-radius: 4px;
		background: rgb(255 255 255 / 15%);
	}

	#music-player .aplayer-controller .aplayer-bar .aplayer-played {
		height: 6px;
		border-radius: 4px;
		background: #fff !important;
	}

	#music-player .aplayer-controller .aplayer-bar .aplayer-played .aplayer-thumb {
		width: 20px;
		height: 20px;
		margin-top: -7px;
		transform: none;
		border: none;
		background: #fff !important;
	}

	#music-player .aplayer-controller .aplayer-time {
		position: absolute;
		bottom: 21px;
		display: flex;
		width: 100%;
		height: 0;
		justify-content: flex-end;
		color: rgb(255 255 255 / 75%);
	}

	#music-player .aplayer-controller .aplayer-time .aplayer-time-inner {
		margin-top: -8px;
		margin-right: 18px;
	}

	#music-player .aplayer-controller .aplayer-time .aplayer-icon {
		width: 2rem;
		height: 2rem;
		margin-left: 15px;
	}

	#music-player .aplayer-controller .aplayer-time .aplayer-icon path {
		fill: rgb(255 255 255 / 85%);
	}

	#music-player .aplayer-controller .aplayer-time .aplayer-icon-back {
		position: absolute;
		left: 0;
	}

	#music-player .aplayer-controller .aplayer-time .aplayer-icon-play {
		position: absolute;
		left: 40px;
	}

	#music-player .aplayer-controller .aplayer-time .aplayer-icon-forward {
		position: absolute;
		left: 80px;
	}

	#music-player .aplayer-controller .aplayer-time .aplayer-icon-menu {
		display: none;
	}

	/* 右侧歌单列表 */
	#music-player .aplayer-list {
		width: 60%;
		height: 100%;
	}

	#music-player .aplayer-list ol {
		max-height: calc(100vh - var(--current-navbar-height) - 2rem) !important;
		padding-right: 1.25rem;
	}

	#music-player .aplayer-list ol li {
		border-top: 1px solid transparent;
		font-size: 0.9rem;
		color: rgb(255 255 255 / 75%);
	}

	#music-player .aplayer-list ol li:hover {
		border-radius: 6px;
		background: rgb(255 255 255 / 12%);
	}

	#music-player .aplayer-list ol li.aplayer-list-light {
		border-radius: 6px;
		background: rgb(255 255 255 / 15%);
	}

	#music-player .aplayer-list ol li.aplayer-list-light .aplayer-list-title {
		font-weight: 700;
		color: #fff;
	}

	#music-player .aplayer-list ol li .aplayer-list-author {
		color: rgb(255 255 255 / 45%);
	}

	/* 移动端 */
	@media (max-width: 768px) {
		.music-tool {
			right: 1rem;
			width: 44px;
			height: 44px;
		}

		#music-switch {
			bottom: 90px;
		}

		#music-random {
			bottom: 144px;
		}

		#music-refresh {
			bottom: 198px;
		}

		.music-page > a.music-tool {
			bottom: 252px;
		}

		#music-player .aplayer {
			flex-direction: column;
			height: auto;
			min-height: calc(100vh - var(--current-navbar-height));
		}

		#music-player .aplayer-body {
			width: 100%;
			height: auto;
			padding: 2rem 1rem 8rem;
		}

		#music-player .aplayer-list {
			width: 100%;
			height: auto;
		}

		#music-player .aplayer-list ol {
			max-height: 38vh !important;
			padding-bottom: 6rem;
		}

		#music-player .aplayer-controller {
			bottom: 36px;
			width: calc(100% - 2rem);
		}

		#music-player .aplayer-controller .aplayer-bar-wrap {
			margin: 0;
		}
	}
</style>
